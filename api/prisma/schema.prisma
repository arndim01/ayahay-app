  destination            Int       @default(0)
  cut_off_condition_type String    @db.VarChar(50)
  cut_off_value          Int       @default(0)
  created_at             DateTime? @default(now()) @db.Timestamp(6)
  created_by             String?   @db.VarChar(255)
  updated_at             DateTime? @default(now()) @updatedAt @db.Timestamp(6)
  updated_by             String?   @db.VarChar(255)

  @@index([origin, destination], map: "idx_origin_destination")
  @@index([shipping_line_id], map: "idx_shipping_line_id")
  @@map("booking_cutoff")
  @@schema("preference")
}

model EmailQueue {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  template_id     Int
  recipient_email String    @db.VarChar(255)
  cc              String?
  bcc             String?
  subject         String    @db.VarChar(255)
  body_variables  Json?
  attachments     Json?
  status          String?   @default("Pending") @db.VarChar(50)
  retry_count     Int?      @default(0)
  error_message   String?
  priority        Int?      @default(5)
  scheduled_at    DateTime? @db.Timestamp(6)
  created_at      DateTime? @default(now()) @db.Timestamp(6)
  updated_at      DateTime? @default(now()) @updatedAt @db.Timestamp(6)
  sender_email    String?   @db.VarChar(255)
  tags            Json?
  is_urgent       Boolean?  @default(false)
  template        Template  @relation(fields: [template_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_template")

  @@map("email_queue")
  @@schema("notification")
}

model Template {
  id               Int          @id @default(autoincrement())
  name             String       @db.VarChar(255)
